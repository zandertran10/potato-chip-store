# Copy this file to .env and fill in the values.
# .env is gitignored. Never commit real keys.
# The app reads these, or the same values from .streamlit/secrets.toml.

SUPABASE_URL=
# The publishable key (sb_publishable_...). NEVER the secret key (sb_secret_...).
# The older name SUPABASE_ANON_KEY also still works.
SUPABASE_PUBLISHABLE_KEY=

# Where order confirmation emails are saved (they are never sent).
OUTBOX_DIR=outbox
