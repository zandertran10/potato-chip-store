# Copy this file to .streamlit/secrets.toml and fill in the values.
# secrets.toml is gitignored. Never commit real keys.
# On Streamlit Community Cloud, paste the same values into the app's "Secrets" settings.
# Same names as in .env.example. Use the publishable key (sb_publishable_...),
# NEVER the secret key (sb_secret_..., formerly service_role).

SUPABASE_URL = ""
SUPABASE_PUBLISHABLE_KEY = ""
